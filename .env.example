# Copy to .env and fill in. NEVER commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here
HF_API_KEY=your-huggingface-api-key-here

# Model IDs (configurable because Google retires model names regularly).
# The project brief used models/gemini-1.5-flash and models/gemini-1.5-pro, which Google has retired.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5

# Image generation tuning
IMAGE_STEPS=25
IMAGE_SIZE=512

# Set to 1 to run the whole pipeline with offline mock AI (no keys / no GPU needed)
COMICCRAFT_MOCK=0
